# Application Configuration
APP_NAME=portfolio-rebalancing-system
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=portfolio_rebalancing
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio_rebalancing

# Policy RAG Configuration
POLICY_DOCUMENTS_DIR=policy_documents
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.5
LOCAL_LLM_URL=http://localhost:11434
