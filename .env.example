# ==============================================================================
# Portfolio Rebalancing Recommendation System - Environment Configuration
# ==============================================================================
# Copy this template to .env and adjust values for your environment.
# In production, all unconfigured auth fails closed. Never commit real secrets.

# ------------------------------------------------------------------------------
# 1. Application Environment
# ------------------------------------------------------------------------------
APP_NAME=portfolio-rebalancing-system
# Deployment environment: 'development', 'staging', or 'production'
# When APP_ENV=production, mock authentication is strictly forbidden and fails closed.
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Connection
# ------------------------------------------------------------------------------
# Required: Full SQLAlchemy-compatible connection URI.
# Scheme must be postgresql:// or postgresql+psycopg2:// (SQLite supported for tests: sqlite:///test.db)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio_rebalancing

# Optional metadata components (used for connection management or external tooling)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=portfolio_rebalancing

# ------------------------------------------------------------------------------
# 3. Authentication & Security Governance
# ------------------------------------------------------------------------------
# Authentication provider: 'production' (fails closed until trusted IdP wired) or 'mock'
AUTH_PROVIDER=production

# Explicit development mock authentication switch: True / False (Default: False)
# When False (default) or APP_ENV=production, all arbitrary / unverified Bearer tokens are rejected.
# Only set to True for offline local developer verification and automated test runs.
ENABLE_DEV_MOCK_AUTH=False

# ------------------------------------------------------------------------------
# 4. Policy RAG & Embeddings
# ------------------------------------------------------------------------------
# Directory containing approved policy documents (PDF, Markdown, TXT)
POLICY_DOCUMENTS_DIR=policy_documents

# Embedding model identifier (FastEmbed / HuggingFace model identifier)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Optional custom directory for caching FastEmbed ONNX models and vector artifacts
# Leave blank to use default user cache directory (~/.cache/fastembed)
EMBEDDING_CACHE_DIR=

# Text chunking and retrieval parameters
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.5

# ------------------------------------------------------------------------------
# 5. Local Ollama LLM Settings
# ------------------------------------------------------------------------------
# Base URL of the local Ollama daemon
LOCAL_LLM_URL=http://localhost:11434

# Target LLM model tag for grounded explanations and policy Q&A
LOCAL_LLM_MODEL=llama3.2

# Request timeout in seconds for LLM generation
LOCAL_LLM_TIMEOUT=5.0
