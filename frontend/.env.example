# YottaFlex Frontend Environment Variables
# Copy to .env.local for local development overrides (do not commit .env.local)

# Backend API Configuration
# In development, leave empty or set to empty string to use Vite's internal reverse proxy.
# If connecting directly to an external backend or cross-origin server with CORS enabled, set the full URL:
# VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=

# Vite Dev Server Proxy Target (used by vite.config.ts in development)
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:8000

# Environment Tier (development, staging, production)
VITE_APP_ENV=development

# Development Authentication Helper
# Backend supported mock tokens in development (when ENABLE_DEV_MOCK_AUTH=true on backend):
# - dev-reviewer-token  (Role: REVIEWER, Reviewer ID: REV-DEV-01)
# - dev-admin-token     (Role: ADMIN, Reviewer ID: REV-DEV-ADMIN)
# - dev-viewer-token    (Role: VIEWER, Reviewer ID: REV-DEV-VIEWER - read only)
VITE_DEFAULT_MOCK_TOKEN=dev-reviewer-token
